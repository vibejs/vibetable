{
  "name": "@usevibejs/table",
  "version": "0.1.0",
  "description": "Powerful headless tables for Vibe.js, powered by TanStack Table Core.",
  "keywords": [
    "datagrid",
    "headless",
    "table",
    "tanstack",
    "typescript",
    "vibejs"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && pnpm --dir examples/kitchen-sink typecheck && node scripts/check-docs.ts",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "test": "vitest run --project unit --project components",
    "test:coverage": "vitest run --coverage --project unit --project components",
    "test:integration": "pnpm build && vitest run --project integration",
    "check": "oxfmt --check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:integration",
    "bench": "node benchmarks/row-models.ts",
    "dev": "pnpm --dir examples/kitchen-sink dev",
    "precheck": "pnpm build",
    "build:examples": "pnpm --dir examples/kitchen-sink build",
    "bench:browser": "vitest run --project integration test/browser.integration.test.ts -t 'bounds DOM rows'",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@tanstack/store": "catalog:",
    "@tanstack/table-core": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@usevibejs/compiler": "catalog:",
    "@usevibejs/language-tools": "catalog:",
    "@usevibejs/ui": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@usevibejs/ui": "^0.1.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.14.0"
}
