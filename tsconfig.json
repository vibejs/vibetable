{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "benchmarks",
    "*.config.ts",
    "test",
    "scripts",
    "examples/*/server.ts",
    "examples/*/vite.config.ts"
  ],
  "exclude": ["src/**/*.vibe.test.ts", "test/**/*.vibe.test.ts", "test/hmr/main.ts", "test/.tmp"]
}
