<script setup lang="ts">
import { computed } from '@usevibejs/ui';
import { isComponentContent, renderContent } from '../../src/index.ts';
import type { TextContent } from '../../src/index.ts';
const props = defineProps<{
  template: TextContent | ((context: never) => unknown);
  context: object;
}>();
const content = computed(() =>
  renderContent(props.template as TextContent | ((context: object) => unknown), props.context),
);
</script>
<template>
  <component
    v-if="isComponentContent(content)"
    :is="content.component"
    :context="content.context"
  />
  <template v-else>{{ content }}</template>
</template>
