<script setup lang="ts">
import type { CellContext } from '@usevibejs/table';
import type { Payment, PaymentFeatures } from './model.ts';
const { context } = defineProps<{
  context: CellContext<PaymentFeatures, Payment, Payment['status']>;
}>();
</script>
<template>
  <span
    :class="[
      'inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-xs font-medium',
      context.getValue() === 'Paid'
        ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400'
        : context.getValue() === 'Failed'
          ? 'border-destructive/20 bg-destructive/10 text-destructive'
          : 'border-border bg-muted text-muted-foreground',
    ]"
    ><span aria-hidden="true" class="size-1.5 rounded-full bg-current" />{{
      context.getValue()
    }}</span
  >
</template>
