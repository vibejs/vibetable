<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import { inject } from '@usevibejs/ui';
import type { ClassValue, Ref } from '@usevibejs/ui';
import { injectMenu, useMenuItem } from '../../lib/menu.ts';
import { cn } from '../../lib/utils.ts';

defineOptions({ inheritAttrs: false });

const { class: className, value, disabled = false } = defineProps<{
  class?: ClassValue;
  value: string;
  disabled?: boolean;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const emit = defineEmits<{ select: [event: Event] }>();
const group = inject<Ref<string>>(Symbol.for('vibecn.menu-radio-group'))!;
const item = useMenuItem(injectMenu(), () => disabled, (event) => {
  group.value = value;
  emit('select', event);
});
const base =
  "relative flex cursor-default items-center gap-2 rounded-sm text-sm outline-hidden select-none focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 py-1.5 pr-2 pl-8";
</script>

<template>
  <div
    role="menuitemradio"
    tabindex="-1"
    data-slot="dropdown-menu-radio-item"
    :aria-checked="group === value"
    :data-state="group === value ? 'checked' : 'unchecked'"
    :data-disabled="disabled || undefined"
    :aria-disabled="disabled || undefined"
    v-bind="$attrs"
    :class="cn(base, className)"
    @pointermove="item.onPointerMove"
    @pointerleave="item.onPointerLeave"
    @keydown="item.onKeydown"
    @click="item.onClick"
  >
    <span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" v-if="group === value" class="size-2"><circle cx="12" cy="12" r="6" /></svg></span>
    <slot />
  </div>
</template>
