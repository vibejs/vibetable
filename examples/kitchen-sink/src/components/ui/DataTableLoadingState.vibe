  <TableRow v-for="index in rows" :key="index" :class="cn(className)"
    ><TableCell v-for="column in Math.max(1, columns)" :key="column" class="h-14"
      ><span v-if="index === 1 && column === 1" role="status" class="sr-only">Loading records</span
      ><Skeleton class="h-4 w-3/4" /></TableCell
  ></TableRow>
</template>
