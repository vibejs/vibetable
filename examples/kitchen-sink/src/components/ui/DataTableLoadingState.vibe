<script setup lang="ts">
import type { ClassValue } from '@usevibejs/ui';
import { cn } from '../../lib/utils.ts';
import TableRow from './TableRow.vibe';
import TableCell from './TableCell.vibe';
import Skeleton from './Skeleton.vibe';
defineOptions({ inheritAttrs: false });
const {
  columns,
  rows = 5,
  class: className,
} = defineProps<{ columns: number; rows?: number; class?: ClassValue }>();
